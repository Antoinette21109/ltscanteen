# Copy this file to .env and fill in your deployment credentials.

# SMTP email receipts and parent reminders
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM=Literacy Tree Canteen <canteen@example.com>

# Browser push reminders (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:admin@literacytree.com

# Cloudinary is required for parent and child profile photo uploads.
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Initial morning-break schedule defaults and school time zone.
# After setup, administrators manage break, lunch, and other schedules in the dashboard.
BREAK_TIME=10:30
BREAK_REMINDER_MINUTES=30
SCHOOL_TIME_ZONE=Africa/Lusaka
